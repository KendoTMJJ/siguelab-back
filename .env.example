PORT=3000

DB_HOST=db
DB_PORT=3306
DB_USER=sigelab
DB_PASSWORD=sigelab
DB_NAME=sigelab

FRONTEND_URL=http://localhost:4200

# Microsoft Entra ID (Azure AD) — única fuente de identidad. Este backend
# solo valida access tokens ya emitidos por Entra (resource server); el
# login/redirect lo hace el frontend con MSAL.
TENANT_ID=
API_CLIENT_ID=
API_APPLICATION_ID_URI=

SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@sigelab.local

# Cómo se consume el aforo de un laboratorio en reservas compartidas:
# 'por_reserva' (cada solicitud aprobada consume 1 cupo) o
# 'por_personas' (consume num_personas cupos).
AFORO_MODO=por_personas

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sigelab.local
